PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=hostel_booking
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_key
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_CLIENT_SECRET=your_client_secret

# Layer 1 Threat Defenses & Limits
PAIRING_MAX_ATTEMPTS=10
PAIRING_WINDOW_MS=600000
CSV_MAX_FILE_SIZE=5242880
PDF_SANITIZE_ENABLE=true

# Layer 2 Identity & Access Management (IAM)
JWT_ACCESS_SECRET=your_256bit_access_secret
JWT_REFRESH_SECRET=your_256bit_refresh_secret
MFA_ENABLED=true
SESSION_SINGLE_DEVICE=true
